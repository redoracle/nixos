{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alpine + Nix Needle catalog",
  "description": "Curated Nix, apk, workspace and diagnostics. Read-only inspection can be executed only with --execute; file creation requires --allow-write; all installs, builds, upgrades and destructive operations are advisory-only. Pi's independent bash tool is not restricted by this policy.",
  "version": 2,
  "groups": {
    "system": "OS and runtime inspection",
    "apk": "Alpine package queries and root-only maintenance plans",
    "nix": "Nix store/profile inspection and trusted-build plans",
    "workspace": "Workspace-confined file actions",
    "workflow": "Composed diagnostics and operational plans"
  },
